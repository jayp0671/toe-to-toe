# Copy to .env.local (gitignored) and fill in. Never commit values. See docs/PLAN.md Appendix A9.

# Web app build (public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Server only (Supabase function secrets / GitHub secrets)
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Phase 0 sync report (pnpm sync-report --env local|staging). Service role: keep in .env.local only.
# Local falls back to `supabase status` when these are empty.
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=

# CI / deploy / backups (GitHub secrets)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
AGE_PUBLIC_KEY=
SMOKE_SYNC_KEY=
CLOUDFLARE_API_TOKEN=
